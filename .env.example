# ─────────────────────────────────────────────────────────────
# AttackDNA configuration
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
# `.env` is git-ignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# Required for AI-generated attack chains.
# Get one at https://console.anthropic.com/
# Without it, AttackDNA still works but shows a generic template chain.
ANTHROPIC_API_KEY=

# Optional: Claude model and reasoning effort (low | medium | high | xhigh | max)
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Optional: NVD API key for higher rate limits (5 → 50 requests / 30s)
# Request one at https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Optional: how long analyzed CVEs stay cached in memory (seconds)
CACHE_TTL_SECONDS=21600

# Server settings
PORT=5000
FLASK_DEBUG=false
